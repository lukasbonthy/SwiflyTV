# SwiflyTV no-env build
# You do not need to set Render env vars for the StreamProvider m3u8 setup.
# The Dockerfile + server.js defaults handle:
# - DEFAULT_PLAY_PROVIDER=streamprovider
# - STREAMPROVIDER_ENABLED=true
# - STREAMPROVIDER_ORDER=hexa,cinezo
# - VIDSRC_ENABLED=false
# - CONSUMET_ENABLED=false
# - FILMU_ENABLED=false
# - Native Playwright cache on Windows; /ms-playwright inside Docker

# Optional only, if your site needs TMDB features:
TMDB_API_KEY=
SITE_NAME=SwiflyTV
SWIFLY_NO_ENV_MODE=true

# StreamProvider now accepts m3u8/mpd/mp4/webm/mkv/etc by default.
STREAMPROVIDER_ACCEPT_ANY_MEDIA=true

# Start a second direct source after 1.8s if the preferred source is still loading.
# Captures share one browser; set MAX_CONCURRENT=1 for a low-memory host.
STREAMPROVIDER_HEDGE_DELAY_MS=1800
STREAMPROVIDER_MAX_CONCURRENT=2

# Whole source-discovery deadline, including fallbacks (10–75 seconds).
MOVIE_SOURCE_DEADLINE_MS=75000
MOVIE_SOURCE_MAX_CONCURRENT=2

# Set on Render (not in GitHub). Until SWIFLY_ACCESS_PIN is set, the site stays public.
# A valid six-digit PIN enables the friends-only gate for ALL pages, APIs and sockets.
SWIFLY_ACCESS_PIN=
# Use a long, random server-side cookie-signing secret so sessions survive deploys.
SWIFLY_ACCESS_SECRET=
# Set to true after the PIN is configured for fail-closed startup behavior.
SWIFLY_ACCESS_REQUIRED=false

# To keep account data across restarts, configure PostgreSQL or a persistent disk.
# Keep this secret in the host environment; do not commit a connection string.
DATABASE_URL=
# Set to file for a persistent directory, or temporary for a single server that
# discards accounts, sessions and screening data whenever the process restarts.
SWIFLY_ACCOUNT_STORE=
SWIFLY_DATA_DIR=
# Enable only when your PostgreSQL provider requires verified TLS.
SWIFLY_DB_SSL=false

# Pinned Nuvio providers available: vidlink,vidsrc,videasy,vidfast,vidrock,
# cineby,vidlove,goated,netmirror,nakios.
# NUVIO_PROVIDER_ORDER=all enables every INSTALLED adapter, not the entire
# upstream 66-entry metadata catalog. Leave unset to use the curated order.
# NUVIO_PROVIDER_ORDER=vidlink,vidsrc,videasy,vidfast,vidrock,cineby,vidlove,goated,netmirror,nakios
# NUVIO_ENABLED=true
# NUVIO_PROVIDER_TIMEOUT_MS=9000
# NUVIO_TIMEOUT_MS=20000

# Optional four-provider 4K bridge (4KHDHub, UHDMovies, MoviesDrive, ShowBox).
# Set ONLY on Render or your private .env to an HTTPS Stremio-compatible addon
# you control or are authorized to use. The formerly public Nuvio instance is retired.
# See docs/four-4k-addon-bridge.md. Empty means disabled.
SWIFLY_STREMIO_ADDON_URL=

# Stable, private parent-lock encryption key (at least 24 bytes). Set in the host.
SWIFLY_KIDS_SECRET=
# Immutable signed-in account IDs allowed to create Community channels/groups.
# Display names never grant permissions. Leave empty for public lounges only.
SOCIAL_CREATOR_ACCOUNT_IDS=
