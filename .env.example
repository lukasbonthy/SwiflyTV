TMDB_API_KEY=your_tmdb_api_key_here
SITE_NAME=DropStream

BRAND_WORDMARK=DROPSTREAM
BRAND_SUBMARK=DROPSTREAM

# Combined scraper backend (SwiflyTV 3.8.1+)
# Swifly starts CinePro on 3100, Paregi Nuvio on 3201, and a merged API on 3200.
HYBRID_CORE_HOST=127.0.0.1
HYBRID_CORE_PORT=3200
HYBRID_CINEPRO_HOST=127.0.0.1
HYBRID_CINEPRO_PORT=3100
HYBRID_NUVIO_HOST=127.0.0.1
HYBRID_NUVIO_PORT=3201
HYBRID_CINEPRO_RESOLVE_TIMEOUT_MS=28000
HYBRID_NUVIO_RESOLVE_TIMEOUT_MS=42000
HYBRID_CACHE_TTL_MS=300000
HYBRID_BACKEND_ORDER=nuvio,cinepro

# Set either requirement to true only when startup should fail if that backend is unavailable.
HYBRID_CINEPRO_REQUIRED=false
HYBRID_NUVIO_REQUIRED=false

# Paregi Nuvio provider pack. The commit is pinned by default; override only after review.
NUVIO_PROVIDERS_REF=8e31152f8fc6a0266c5153ec7641f7341d120fde
NUVIO_PROVIDER_TIMEOUT_MS=12000
NUVIO_PROVIDER_CONCURRENCY=8
NUVIO_CACHE_TTL_MS=600000

# Optional Nuvio provider tuning. Blank allowlist means every enabled manifest provider.
NUVIO_PROVIDER_ALLOWLIST=
NUVIO_PROVIDER_DENYLIST=
NUVIO_PROVIDER_ORDER=vidking,vixsrc,vidlink,moviebox,showbox

# CinePro remains active as the second backend.
CINEPRO_PROVIDER_ALLOWLIST=*
CINEPRO_PROVIDER_TIMEOUT_MS=15000
CINEPRO_CACHE_TYPE=memory

# Browsers generally cannot play MKV directly. Keep false unless an external player is added.
NUVIO_ALLOW_MKV=false

# Licensed movie provider adapter
# Only set these when you have legal rights / licensed access to the provider.
LICENSED_MOVIE_PROVIDER_ENABLED=false
LICENSED_MOVIE_PROVIDER_API_URL=
LICENSED_MOVIE_PROVIDER_API_KEY=

# Movie button temporary trailer-stream placeholder provider
# Use this for a trailer/preview stream provider now; later swap it to your licensed movie provider.
MOVIE_PLACEHOLDER_PROVIDER_ENABLED=false
MOVIE_PLACEHOLDER_PROVIDER_API_URL=
MOVIE_PLACEHOLDER_PROVIDER_API_KEY=

# Optional param mapping. Defaults match the response/API shape you showed:
MOVIE_PLACEHOLDER_NAME_PARAM=name
MOVIE_PLACEHOLDER_YEAR_PARAM=year
MOVIE_PLACEHOLDER_ID_PARAM=id
MOVIE_PLACEHOLDER_IMDB_PARAM=imdb

# Optional extra query string, for example: turnstile=12
MOVIE_PLACEHOLDER_EXTRA_QUERY=

# Prefer the MP4/ORG stream for the Movie button when the provider returns multiple qualities.
MOVIE_PLACEHOLDER_PREFER_MP4=true
MOVIE_PLACEHOLDER_PREFERRED_QUALITY=ORG

# Try MP4 first, then HLS/AUTO fallback with hls.js when MP4 fails or is missing.
MOVIE_PLACEHOLDER_ALLOW_HLS_FALLBACK=true
