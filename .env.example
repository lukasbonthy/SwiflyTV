# SwiflyTV no-env build
# You do not need to set Render env vars for the StreamProvider m3u8 setup.
# The Dockerfile + server.js defaults handle:
# - DEFAULT_PLAY_PROVIDER=streamprovider
# - STREAMPROVIDER_ENABLED=true
# - STREAMPROVIDER_ORDER=hexa,cinezo
# - VIDSRC_ENABLED=false
# - CONSUMET_ENABLED=false
# - FILMU_ENABLED=false
# - PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Optional only, if your site needs TMDB features:
TMDB_API_KEY=
SITE_NAME=SwiflyTV
SWIFLY_NO_ENV_MODE=true

# StreamProvider now accepts m3u8/mpd/mp4/webm/mkv/etc by default.
STREAMPROVIDER_ACCEPT_ANY_MEDIA=true
